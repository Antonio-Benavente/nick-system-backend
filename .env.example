# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=4000
NODE_ENV=development

# ==========================================
# PROXIES (Render/Cloudflare delante de la API)
# Numero de proxiesconfiables. 1 = un salto (Render).
# ==========================================
TRUST_PROXY=1

# ==========================================
# BASE DE DATOS MYSQL
# ==========================================
DATABASE_URL=mysql://root@localhost:3307/nicksystemlocal

# ==========================================
# AUTENTICACIÓN JWT
# ==========================================
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# ==========================================
# SERVICIO DE EMAIL - RESEND (envío)
# ==========================================
EMAIL_FROM="Nick System <soporte@nicksystem.com>"
RESEND_API_KEY=re_xxxxxxxxx

# ==========================================
# FRONTEND URL
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# CORS - DOMINIOS PERMITIDOS (separados por comas)
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# TICKETS ENTRANTES - RESEND INBOUND (webhook)
# ==========================================
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# ==========================================
# TICKETS ENTRANTES - WHATSAPP CLOUD API
# ==========================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_CONVERSACION_MINUTOS=30

# ==========================================
# TICKETS ENTRANTES - VALORES POR DEFECTO
# ==========================================
TICKET_EMPRESA_CORREO=G
TICKET_EMPRESA_WHATSAPP=WhatsApp
