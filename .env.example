# ------------------------------------------
# SERVIDOR
# ------------------------------------------
PORT=4000
NODE_ENV=development
TRUST_PROXY=1

# ------------------------------------------
# BASE DE DATOS (MySQL local - XAMPP, puerto 3307)
# ------------------------------------------
DATABASE_URL=mysql://root@localhost:3307/nicksystemlocal

# ------------------------------------------
# AUTENTICACION (JWT)
# ------------------------------------------
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d
# Expiración del token de la app Android. Es solo un respaldo: el control real
# es la revocación por dispositivo. No bajar de 1d sin revisar la purga.
JWT_EXPIRES_IN_APP_TECNICOS=365d

# Clave del HMAC con el que se genera el codigo publico del ticket
# (TK-<iniciales><5 chars>). Si se deja vacia, cae a JWT_SECRET.
# En Render se genera sola (generateValue: true).
TICKET_CODIGO_SECRET=

# Clave AES-256-GCM para cifrar las contrasenas de la tabla claves.
# Acepta 32 bytes en base64 (44 chars), 64 caracteres hex o 32 chars UTF-8.
# Generar: openssl rand -base64 32
# PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Obligatoria en produccion. En desarrollo, si falta, se guarda sin cifrar.
CLAVES_ENCRYPTION_KEY=

# ------------------------------------------
# CORS Y FRONTEND
# ------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Zona horaria de la aplicacion. La base guarda UTC y la API
# presenta las fechas en esta zona.
APP_TIMEZONE=America/Lima

# ------------------------------------------
# OBSERVABILIDAD
# ------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Sentry es opcional: sin SENTRY_DSN no se inicializa.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------
# FEATURE FLAGS (migracion gradual)
# ------------------------------------------
# off | observe | enforce
FF_INCOMING_EVENTS=observe
FF_ZOD_VALIDATION=observe
# off | enforce
FF_IDEMPOTENCY=off
# off | enforce: envío de push de la app de técnicos
FF_PUSH=off

# ------------------------------------------
# APP DE TECNICOS (Android)
# ------------------------------------------
# Token de Expo (opcional). Sin él Expo acepta el envío sin autenticación.
EXPO_ACCESS_TOKEN=
# Versión mínima aceptada por la app (formato 1.2.3).
APP_TECNICOS_VERSION_MINIMA=1.0.0
# URL fija del APK. Vacía = /publico/app-tecnicos responde url_descarga null.
APP_TECNICOS_URL_DESCARGA=

# ------------------------------------------
# CORREO (Resend)
# ------------------------------------------
EMAIL_FROM="Nick System <pruebas@nicksystem.com>"
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# ------------------------------------------
# WHATSAPP (Meta Cloud API)
# ------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

# ------------------------------------------
# TICKETS ENTRANTES
# ------------------------------------------
WHATSAPP_CONVERSACION_MINUTOS=30
WHATSAPP_MENSAJES_DIAS=7
WHATSAPP_INTENTOS_MAXIMOS=2
WHATSAPP_CONSULTA_TICKET_DIAS=90
# Prefijo que se antepone a un numero local de 9 digitos (Peru = 51).
WHATSAPP_PREFIJO_PAIS=51
TICKET_EMPRESA_CORREO=G
TICKET_EMPRESA_WHATSAPP=WhatsApp
TICKET_NOTIFICACION_EMAIL=
TICKET_URGENCIA_TELEFONO=
TICKET_URGENCIA_EMAIL=

# ------------------------------------------
# EVIDENCIAS (validacion en el backend)
# ------------------------------------------
# Tamano maximo por archivo, en MB.
EVIDENCIAS_MAX_MB=10
# Hosts permitidos para las URLs de evidencias, separados por coma.
# Si queda vacio se usa res.cloudinary.com.
EVIDENCIAS_HOSTS=

# ------------------------------------------
# ARRANQUE EN FRIO (Render)
# ------------------------------------------
# Ping periodico a /health para que la instancia no se
# duerma y el primer webhook no llegue a un arranque en frio.
# El destino es WARMUP_URL y, si no se define, la URL publica
# que Render inyecta como RENDER_EXTERNAL_URL. Sin ninguna de las
# dos el ping queda desactivado.
# OJO: el plan gratis de Render da 750 h de instancia al mes y
# una instancia siempre encendida las consume casi todas. Por eso
# el ping solo corre dentro de WARMUP_HORARIO (hora de Lima).
WARMUP_URL=
WARMUP_MINUTOS=10
WARMUP_HORARIO=08:00-22:00
# Render la inyecta sola; se usa como respaldo cuando WARMUP_URL esta vacia.
RENDER_EXTERNAL_URL=