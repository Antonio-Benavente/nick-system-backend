# ------------------------------------------
# SERVIDOR
# ------------------------------------------
PORT=4000
NODE_ENV=development
TRUST_PROXY=1

# ------------------------------------------
# BASE DE DATOS (MySQL local - XAMPP, puerto 3307)
# ------------------------------------------
DATABASE_URL=mysql://root@localhost:3307/nicksystemlocal

# ------------------------------------------
# AUTENTICACION (JWT)
# ------------------------------------------
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# Clave del HMAC con el que se genera el codigo publico del ticket
# (TK-<iniciales><5 chars>). Si se deja vacia, cae a JWT_SECRET.
# En Render se genera sola (generateValue: true).
TICKET_CODIGO_SECRET=

# ------------------------------------------
# CORS Y FRONTEND
# ------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------
# CORREO (Resend)
# ------------------------------------------
EMAIL_FROM="Nick System <pruebas@nicksystem.com>"
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# ------------------------------------------
# WHATSAPP (Meta Cloud API)
# ------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

# ------------------------------------------
# TICKETS ENTRANTES
# ------------------------------------------
WHATSAPP_CONVERSACION_MINUTOS=30
TICKET_EMPRESA_CORREO=G
TICKET_EMPRESA_WHATSAPP=WhatsApp
# Destinatarios (separados por coma) del aviso interno de ticket
# entrante por correo o WhatsApp. VACIA = aviso desactivado:
# el ticket se crea pero nadie se entera.
TICKET_NOTIFICACION_EMAIL=

# ------------------------------------------
# ARRANQUE EN FRIO (Render)
# ------------------------------------------
# Ping periodico a /health para que la instancia no se
# duerma y el primer webhook no llegue a un arranque en frio.
# El destino es WARMUP_URL y, si no se define, la URL publica
# que Render inyecta como RENDER_EXTERNAL_URL. Sin ninguna de las
# dos el ping queda desactivado.
# OJO: el plan gratis de Render da 750 h de instancia al mes y
# una instancia siempre encendida las consume casi todas. Por eso
# el ping solo corre dentro de WARMUP_HORARIO (hora de Lima).
WARMUP_URL=
WARMUP_MINUTOS=10
WARMUP_HORARIO=08:00-22:00